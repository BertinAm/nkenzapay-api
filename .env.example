# Copy to .env and fill in. The real file is never committed.

DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=api.nkenzapay.com

# The front end and the API sit on two hosts that share a registrable domain,
# which keeps them same-site and lets one session cookie serve both.
COOKIE_DOMAIN=.nkenzapay.com
CORS_ALLOWED_ORIGINS=https://nkenzapay.com
CSRF_TRUSTED_ORIGINS=https://nkenzapay.com,https://api.nkenzapay.com

DATABASE_URL=

# Which headers may be believed for the caller's address. Set this ONLY to a
# header your own proxy writes — behind Cloudflare that is HTTP_CF_CONNECTING_IP.
# Trusting a header nothing sets lets anyone forge their address and walk past
# a block. Leave empty when the app is reached directly.
TRUSTED_IP_HEADERS=

# How many hostile events from one address before it is refused, as JSON.
# The defaults are in the source and therefore public; set your own so an
# attacker reading the code cannot work out how to stay underneath them.
#   {"login_failed": 12, "scanner": 8}
SECURITY_THRESHOLDS=

# Foreign exchange. Read on the server only and never sent to a browser.
FX_PROVIDER=xe
FX_API_KEY=
FX_API_ACCOUNT_ID=

# Private storage for payment evidence, profile photographs and receipts.
#
# "local" writes to MEDIA_ROOT, which must sit outside the web root. On shared
# hosting that is the only option, and it is workable because every file is
# sealed with AES-256-GCM before it is written. "s3" hands the files to object
# storage instead, which is better if you have it.
MEDIA_STORAGE=local

# Required when MEDIA_STORAGE=local. Generate with:
#   python manage.py generate_media_key
#
# This is what stands between a copy of the disk and a folder of customers'
# identity photographs, so it does not belong in the same backup as the files.
# Losing it means losing the files: nothing else can open them.
#
# Rotating: put the new key first, keep the old one, run
# `manage.py encrypt_media`, then drop the old one.
#   MEDIA_ENCRYPTION_KEYS=k2:<new base64>,k1:<old base64>
MEDIA_ENCRYPTION_KEY=
MEDIA_ENCRYPTION_KEYS=

# How many days after a transfer closes its attachments are deleted. The file
# goes; the record that it existed stays. 0 keeps everything forever, which is
# rarely the right answer — held data is the risk that grows on its own. Check
# your own record-keeping obligations before choosing the number.
# Swept by `manage.py sweep_media`, which the nightly cron runs.
MEDIA_RETENTION_DAYS=0

# How long an uploaded file may sit unattached before the sweep removes it. A
# customer who closes the tab mid-upload leaves bytes nothing points at.
UPLOAD_ORPHAN_HOURS=24

# Only when MEDIA_STORAGE=s3.
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NkenzaPay <no-reply@nkenzapay.com>

# Optional. Enables websockets and background workers where a long-lived
# process is available; everything degrades gracefully without it.
REDIS_URL=
